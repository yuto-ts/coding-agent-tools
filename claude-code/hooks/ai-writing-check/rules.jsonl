# ai-writing-check の NG ルール。1 行 1 ルールの JSONL。
# {"id": 一意な名前, "pattern": Python 正規表現(行単位で照合), "good": 書き直しの指針}
# 「#」始まりの行はコメント。/add-writing-rule で追記する。
# --- 決め台詞・体言止めの断定 ---
{"id": "kakushin", "pattern": "(が|の)(核心|真骨頂|要諦)(です|だ|。)", "good": "言い切りをやめ、根拠を平叙文で書く(例: 実測では待ち時間の 8 割がこのロック取得で発生していた)"}
{"id": "inochi", "pattern": "(が|の)命(です|だ|。)", "good": "何がどう重要かを主語と述語のある文で書く"}
{"id": "kimo", "pattern": "(が|の)肝(です|だ|。|になります)", "good": "何がどう重要かを主語と述語のある文で書く"}
{"id": "tsukiru", "pattern": "に尽き(ます|る)", "good": "「〜に尽きる」でまとめず、理由をそのまま書く"}
{"id": "kosoga", "pattern": "こそが(本質|核心|重要|鍵|命)", "good": "強調をやめ、事実と根拠を平叙文で書く"}
{"id": "honshitsu", "pattern": "(が|の)本質(です|だ|。)", "good": "何がどうなっているかを具体的に書く"}
{"id": "kagi", "pattern": "(が|の)鍵(です|だ|。|となる|になる)", "good": "何をすると何が変わるのかを具体的に書く"}
# --- 頼んでいない対比(AではなくB) ---
{"id": "tannaru", "pattern": "単なる.{0,25}(では(ない|なく|ありません)|にとどまらな(い|く)|を超え(る|ます|た))", "good": "対比が不要なら、実際にやったこと・あるものを肯定形で直接書く"}
{"id": "toiu-mushiro", "pattern": "というより、?むしろ", "good": "言いたい内容を肯定形で直接書く"}
{"id": "dehanaku-mushiro", "pattern": "ではなく、?むしろ", "good": "言いたい内容を肯定形で直接書く"}
{"id": "dakedehanai", "pattern": "だけでは(ない|ありません)(。|$)", "good": "否定で引っ張らず、追加で言いたい内容をそのまま書く"}
# --- 中身を書かない述語 ---
{"id": "kiku", "pattern": "(が|に)効(く|きます)", "good": "「効く」で済ませず、何にどう作用するかを書く(例: 真価は〜にある / 本領を発揮するのは〜)"}
{"id": "jitsugen", "pattern": "を実現(します|しました|できます)", "good": "何がどう動くようになったかを具体的に書く。主語を動詞の主体にして直接書く(例: この関数はキャッシュを再利用する)"}
{"id": "kanou-ni", "pattern": "を可能に(します|しました|できます)", "good": "できるようになった操作・結果を具体的に書く"}
{"id": "juyo-kyocho", "pattern": "(極めて|非常に|とても)重要", "good": "何にどう重要か、影響の中身を書く。強調語は削る"}
{"id": "zettai-ippanka", "pattern": "常に.{0,15}(べき|ます。)|必ず.{0,10}して(ください|おきましょう)", "good": "適用条件と例外を書くか、根拠(仕様・実測)を添える"}
# --- 前置き・締めの定型 ---
{"id": "ii-shitsumon", "pattern": "(いい|良い|素晴らしい|するどい|鋭い)(ご)?(質問|指摘|着眼点?)", "good": "前置きの褒めを書かず、本題から始める"}
{"id": "oyakuni", "pattern": "お役に立て(れば|たら|ましたら)幸い", "good": "定型の締めを書かず、報告が終わったらそこで終える"}
{"id": "sankou-saiwai", "pattern": "参考になれば幸い", "good": "定型の締めを書かず、報告が終わったらそこで終える"}
{"id": "nanika-areba", "pattern": "(何か|ご不明な点が)(あれば|ございましたら)", "good": "定型の締めを書かず、報告が終わったらそこで終える"}
{"id": "okigaruni", "pattern": "お気軽に(お問い合わせ|ご相談|お申し付け)", "good": "定型の締めを書かず、報告が終わったらそこで終える"}
{"id": "gokakunin", "pattern": "ご確認ください", "good": "定型の締めを書かず、報告が終わったらそこで終える"}
# --- 誇張形容詞(数値・事実に置き換える) ---
{"id": "gekiteki", "pattern": "劇的(に|な)", "good": "測定値で書く(例: 4.2 秒 → 1.1 秒、3 回平均)。計測していないなら「計測していない」と書く"}
{"id": "oohaba", "pattern": "大幅(に|な)", "good": "測定値・件数で書く。計測していないなら「計測していない」と書く"}
{"id": "hiyakuteki", "pattern": "飛躍的(に|な)", "good": "測定値・件数で書く。計測していないなら「計測していない」と書く"}
{"id": "attouteki", "pattern": "圧倒的(に|な)", "good": "比較対象と差分を数値で書く"}
{"id": "zetsudai", "pattern": "絶大(な|に)", "good": "測定値・件数で書く。計測していないなら「計測していない」と書く"}
{"id": "kenrou", "pattern": "堅牢(な|に)", "good": "どの障害・入力にどう耐えるのかを列挙する(例: HTTP 5xx とタイムアウトは 3 回まで再試行、4xx は再試行しない)"}
{"id": "seamless", "pattern": "シームレス(に|な)", "good": "ユーザーから見て何の手順が不要になるのかを書く"}
{"id": "kyouryoku", "pattern": "非常に強力", "good": "何ができるのかを機能・数値で列挙する"}
{"id": "kakushinteki", "pattern": "革新的(な|に)", "good": "従来との差分を事実で書く"}
{"id": "kanpeki", "pattern": "完璧(な|に)", "good": "確認した範囲と未確認の範囲を書き分ける"}
{"id": "mouraTeki", "pattern": "網羅的(に|な)", "good": "件数と未カバー範囲を書く(例: テストを 6 件追加。タイムアウト時は未カバー)"}
{"id": "saisentan", "pattern": "最先端", "good": "具体的な技術名・バージョン・出典を書く"}
{"id": "takuetsu", "pattern": "卓越した", "good": "根拠となる事実・数値を書く"}
{"id": "senren", "pattern": "洗練された", "good": "何がどう変わったのかを具体的に書く"}
{"id": "mahou", "pattern": "魔法のよう", "good": "仕組みをそのまま説明する"}
{"id": "game-changer", "pattern": "ゲームチェンジャー", "good": "何がどう変わるのかを事実で書く"}
# --- 常套句・レトリック ---
{"id": "iumademonaku", "pattern": "言うまでもなく", "good": "前置きを削り、内容だけを書く"}
{"id": "ieru-deshou", "pattern": "と言えるでしょう", "good": "断定できるなら断定し、推測なら「〜だと思います。未確認です」と書く"}
{"id": "dehanaideshouka", "pattern": "(の)?ではないでしょうか", "good": "反語をやめ、判断と根拠をそのまま書く"}
{"id": "chuumoku", "pattern": "注目すべき(は|点)", "good": "煽らずに事実から書き始める"}
{"id": "tokuhitsu", "pattern": "特筆すべき", "good": "煽らずに事実から書き始める"}
{"id": "shinka-toge", "pattern": "進化を遂げ", "good": "何がどう変わったのかを事実で書く"}
